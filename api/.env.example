DATABASE_URL="mysql://user:password@host:port/dbname?ssl-mode=REQUIRED&connection_limit=1"
TEST_DATABASE_URL="mysql://user:password@localhost:3307/portfolio_test_db"
LOG_LEVEL="info"

# Firebase Admin SDK（サービスアカウントの秘密鍵）
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Gmail SMTP（お問い合わせフォームのメール転送用）
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-gmail-app-password"

# CORS（本番ドメインを許可する場合に設定。同一Vercelプロジェクト運用時は不要）
# ALLOWED_ORIGIN="https://your-portfolio.vercel.app"